<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Project identity: same groupId as the RESTful server -->
    <groupId>ec.edu.monster</groupId>
    <artifactId>web_eurekabank_restful_java</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- war = web application deployed on Payara -->
    <packaging>war</packaging>
    <name>web_eurekabank_restful_java</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Compile for Java 17, the same version as the server -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Jakarta EE 10 runs on both Payara 6 and Payara 7 -->
        <jakartaee>10.0.0</jakartaee>
    </properties>

    <dependencies>
        <!-- Jakarta EE API (Servlet, JSP, ...).
             provided: needed to compile, but Payara already ships it,
             so it is NOT packaged inside the .war -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee}</version>
            <scope>provided</scope>
        </dependency>
        <!-- JSON parsing of the REST answers; packaged in WEB-INF/lib.
             HTTP goes through java.net.http.HttpClient from the JDK -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20250517</version>
        </dependency>

        <!-- ===== Test-only dependencies (never packaged in the .war) ===== -->
        <!-- JUnit 5: writes and runs the tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <!-- Mockito: fake HttpServletRequest/Response/Session for the controllers -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.20.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Name of the .war, which is also the URL context root:
             http://localhost:8080/web_eurekabank_restful_java/ -->
        <finalName>web_eurekabank_restful_java</finalName>
        <plugins>
            <!-- Compiles the Java code using maven.compiler.release -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Packages the web application as a .war -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <!-- Runs the JUnit 5 tests during mvn test / mvn package -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
